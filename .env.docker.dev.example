# Docker dev profile — copy to .env.docker.dev (git-ignored) and fill in values.
#
# ── Local dev /etc/hosts prerequisite ─────────────────────────────────────
# These hostnames must resolve to localhost. Run once on your dev machine:
#
#   sudo tee -a /etc/hosts <<EOF
#   127.0.0.1 auth-dev.velobits.dev
#   127.0.0.1 api-dev.velobits.dev
#   127.0.0.1 develop-fixmytext.velobits.dev
#   EOF
#
# Without these entries the OIDC redirects + API calls will fail.

# ── Backend API URL (Kong API gateway behind Traefik) ─────────────────────
VITE_API_URL=http://api-dev.velobits.dev

# ── Keycloak OIDC (auth provider — Velobits-Dev realm) ────────────────────
VITE_KEYCLOAK_URL=http://auth-dev.velobits.dev
VITE_KEYCLOAK_REALM=Velobits-Dev
VITE_KEYCLOAK_CLIENT_ID=develop-fixmytext

# ── Sentry (error tracking) ───────────────────────────────────────────────
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
# CI-only — not needed for local dev unless testing source map upload
SENTRY_AUTH_TOKEN=
SENTRY_ORG=velobits-lb

# ── Social login providers (comma-separated: google, github, sso) ─────────
VITE_KEYCLOAK_ENABLED_PROVIDERS=google,github
# SSO domain-to-IDP mapping (e.g. acme.com:acme-sso,example.org:example-sso)
VITE_SSO_DOMAIN_MAP=

# ── Module Federation remote entry URLs ───────────────────────────────────
# DEV: point directly at each remote's Vite dev server port, NOT through the
# nginx router. Vite's federation runtime requests /node_modules/.vite/... at
# root level (no /app/ prefix). Going via the router routes those to the Next.js
# content app (the /* catch-all) → 404. Direct ports bypass that entirely.
VITE_EDITOR_REMOTE_ENTRY=http://localhost:3101/remoteEntry.js
VITE_ANALYTICS_REMOTE_ENTRY=http://localhost:3102/remoteEntry.js

# ── Feature flags ──────────────────────────────────────────────────────────
# Gamification kill switch: absent/true ⇒ enabled; 'false' ⇒ gamification dark (no fetches/PUTs, gamification=null in AppContext).
VITE_GAMIFICATION_ENABLED=true

# PROD docker profile (.env.docker.prod): use the router paths instead:
# VITE_EDITOR_REMOTE_ENTRY=http://localhost:3000/remotes/editor/remoteEntry.js
# VITE_ANALYTICS_REMOTE_ENTRY=http://localhost:3000/remotes/analytics/remoteEntry.js
