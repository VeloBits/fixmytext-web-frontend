# Frontend environment variables — Sprint 5b
# To override defaults, copy this file to .env (git-ignored).
#
# ── Local dev /etc/hosts prerequisite ─────────────────────────────────────
# These hostnames must resolve to localhost. Run once on your dev machine:
#
#   sudo tee -a /etc/hosts <<EOF
#   127.0.0.1 auth-dev.velobits.dev
#   127.0.0.1 api-dev.velobits.dev
#   127.0.0.1 local-fixmytext.velobits.dev
#   EOF
#
# Without these entries the OIDC redirects + API calls will fail.
# The local host must stay a *.velobits.dev name (Keycloak redirect URIs + the
# `.velobits.dev`-scoped SSO cookie), but it must NOT shadow a deployed one:
# develop-fixmytext.velobits.dev is the live develop origin and
# fixmytext.velobits.dev is production — an /etc/hosts entry for either would
# make the real site unreachable from this machine. Hence the `local-` prefix,
# which is reserved for loopback and never deployed.

# ── Backend API URL (Kong API gateway behind Traefik) ─────────────────────
VITE_API_URL=http://api-dev.velobits.dev

# ── Keycloak OIDC (auth provider — Velobits realm) ────────────────────
VITE_KEYCLOAK_URL=http://auth-dev.velobits.dev
VITE_KEYCLOAK_REALM=Velobits
VITE_KEYCLOAK_CLIENT_ID=develop-fixmytext

# ── Sentry (error tracking) ───────────────────────────────────────────────
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
# CI-only — not needed for local dev unless testing source map upload
SENTRY_AUTH_TOKEN=
SENTRY_ORG=velobits-lb

# ── Social login providers (comma-separated: google, github, sso) ─────────
VITE_KEYCLOAK_ENABLED_PROVIDERS=google,github
# SSO domain-to-IDP mapping (e.g. acme.com:acme-sso,example.org:example-sso)
VITE_SSO_DOMAIN_MAP=

# ── Module Federation remote entry URLs ───────────────────────────────────
# The shell always loads Editor and Dashboard from separate remote builds.
# For bare local dev (no Docker), point directly at the Vite dev servers:
VITE_EDITOR_REMOTE_ENTRY=http://localhost:3101/remoteEntry.js
VITE_ANALYTICS_REMOTE_ENTRY=http://localhost:3102/remoteEntry.js
# When running via Docker Compose, both remotes are served through the nginx
# router on port 3000 — use .env.docker.dev instead of this file.
