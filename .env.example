# Frontend environment variables
# To override the backend URL, copy this file to .env (git-ignored)

# FastAPI backend base URL
VITE_API_URL=http://localhost:8000

# Keycloak OIDC (auth provider)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=fixmytext
VITE_KEYCLOAK_CLIENT_ID=fixmytext-frontend

# Sentry (error tracking)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
# CI-only — not needed for local dev unless testing source map upload
SENTRY_AUTH_TOKEN=
SENTRY_ORG=velobits-lb
