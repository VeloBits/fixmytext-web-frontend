# Content app environment variables
# Copy to .env.local (git-ignored) for local development.

# ── API URL (Kong API gateway via Traefik) ──────────────────────────────────
# Used by server-side fetch helpers in lib/api.ts.
# In production this is the internal container URL (doesn't go through Traefik).
CONTENT_API_URL=http://api-dev.velobits.dev
NEXT_PUBLIC_API_URL=http://api-dev.velobits.dev

# ── Site URL (for OG meta + canonical URLs) ────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://develop-fixmytext.velobits.dev

# ── Auth.js ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Session cookie verification ─────────────────────────────────────────────
# Must equal SESSION_COOKIE_SECRET in backend/.env so the content-app can
# verify the HMAC-signed session cookie set by account-svc.
# When unset, content-app sessions stay anonymous (no crash, just no user).
# Generate: openssl rand -base64 48
COOKIE_SECRET=
