{
  "name": "@velobits/content-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3103",
    "build": "next build",
    "start": "next start --port 3103",
    "lint": "eslint app/ components/ lib/",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "build:cf": "npx @opennextjs/cloudflare build",
    "preview:cf": "npm run build:cf && wrangler dev --port 3103 --ip 0.0.0.0"
  },
  "dependencies": {
    "@velobits/api-client": "*",
    "@velobits/auth-shared": "*",
    "@velobits/design-system": "*",
    "@velobits/tools-registry": "*",
    "next": "^15.5.19",
    "next-auth": "^5.0.0-beta.28",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "framer-motion": "^12.38.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.0.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.97.0"
  }
}
