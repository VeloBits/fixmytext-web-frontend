{
  // audit-ci config for the Frontend CI `security` job.
  //
  // Gate: fail CI on any HIGH or CRITICAL advisory across the FULL dependency
  // tree (prod + dev). This keeps a real supply-chain gate — a new high vuln in
  // ANY package (including build/test tooling) still fails CI.
  //
  // The allowlist below waives ONLY advisories that are:
  //   (a) confined to the Cloudflare deploy toolchain (wrangler / miniflare /
  //       @opennextjs) — never shipped in the browser bundle, never run by the
  //       CI build/test jobs (those use `vite build` / `next build`), and
  //   (b) genuinely unfixable: every current version of that toolchain is flagged
  //       (no forward fix), npm's only offered fix is a breaking `wrangler@3.6.0`
  //       downgrade, and `overrides` can't reach the exact-pinned transitive deps.
  // Verified: `npm audit --omit=dev --audit-level=high` is clean — none of these
  // are in the production runtime tree.
  //
  // REVIEW-BY: 2026-09-15 — re-check whether upstream has shipped patched
  // wrangler / miniflare / @opennextjs / esbuild / ws releases and shrink this list.
  "high": true,
  "critical": true,
  "allowlist": [
    // esbuild — arbitrary file read via dev server (Windows-only). Reachable only
    // when running `esbuild --serve`; not exercised by `wrangler deploy` on Linux.
    // Pinned by wrangler@4.97.0 (esbuild 0.27.3) and @opennextjs/aws (esbuild 0.25.4).
    "GHSA-g7r4-m6w7-qqqr",
    // esbuild — Deno NPM_CONFIG_REGISTRY RCE at install time. N/A: we install via npm.
    "GHSA-gv7w-rqvm-qjhr",
    // ws — memory-exhaustion DoS. `ws` here is miniflare's LOCALHOST dev WebSocket
    // (the local Workers simulator); production runs on Cloudflare's edge runtime.
    "GHSA-96hv-2xvq-fx4p",
    // ws — uninitialized-memory disclosure. Same miniflare localhost-only path.
    "GHSA-58qx-3vcg-4xpx",
    // form-data — CRLF injection. Reached via @opennextjs/cloudflare -> cloudflare
    // API SDK at deploy time only; never on a user-facing request path.
    "GHSA-hmw2-7cc7-3qxx"
  ]
}
