# Development image for apps/content (Next.js).
# Uses plain next dev - no CF compilation step for faster iteration.

FROM node:24-alpine

WORKDIR /app

COPY . .
RUN npm install --loglevel=error

EXPOSE 3103

# The package.json "dev" script owns the port (3103) - same value everywhere,
# so there is nothing to override here.
CMD ["npm", "run", "dev", "-w", "@velobits/content-app"]
