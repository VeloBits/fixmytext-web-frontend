# nginx reverse proxy — routes to all MFE containers.
# Replicates the Cloudflare Worker routing logic locally.

FROM nginx:1.27-alpine

ARG NGINX_CONF=docker/nginx.router.dev.conf
RUN rm /etc/nginx/conf.d/default.conf
COPY ${NGINX_CONF} /etc/nginx/conf.d/router.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
