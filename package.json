{
  "name": "velobits-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "worker"
  ],
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@hookform/resolvers": "^5.2.2",
    "@reduxjs/toolkit": "^2.11.2",
    "@sentry/react": "^10.53.1",
    "blakejs": "^1.2.1",
    "blueimp-md5": "^2.19.0",
    "docx": "9.6.1",
    "dompurify": "3.4.11",
    "framer-motion": "^12.38.0",
    "js-sha256": "^0.11.1",
    "js-sha3": "^0.9.3",
    "js-sha512": "^0.9.0",
    "jspdf": "4.2.1",
    "marked": "^18.0.3",
    "murmurhash3js": "^3.0.1",
    "oidc-client-ts": "^3.5.0",
    "prettier": "^3.8.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.15.0",
    "sql-formatter": "^15.7.3",
    "whirlpool-hash": "^1.1.6",
    "xxhashjs": "^0.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@sentry/vite-plugin": "^5.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "axe-core": "^4.11.4",
    "emoji-mart": "^5.6.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^17.6.0",
    "husky": "9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.6",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "@emoji-mart/react": {
      "react": "$react"
    },
    "@module-federation/dts-plugin": {
      "typescript": "$typescript"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "ws": "8.21.0",
    "esbuild": "0.28.1",
    "form-data": "4.0.6",
    "js-yaml": "4.2.0",
    "next": {
      "postcss": "^8.5.15"
    }
  },
  "scripts": {
    "dev": "npm run dev -w @velobits/shell",
    "dev:shell": "npm run dev -w @velobits/shell",
    "dev:editor": "npm run dev -w @velobits/editor-remote",
    "dev:analytics": "npm run dev -w @velobits/analytics-remote",
    "dev:content": "npm run dev -w @velobits/content-app",
    "build": "npm run build -w @velobits/shell",
    "build:all": "npm run build -w @velobits/shell && npm run build -w @velobits/editor-remote && npm run build -w @velobits/analytics-remote && npm run build -w @velobits/content-app",
    "build:shell": "npm run build -w @velobits/shell",
    "build:editor": "npm run build -w @velobits/editor-remote",
    "build:analytics": "npm run build -w @velobits/analytics-remote",
    "build:content": "npm run build -w @velobits/content-app",
    "preview": "npm run preview -w @velobits/shell",
    "lint": "eslint apps/shell/src/ apps/editor-remote/src/ apps/analytics-remote/src/ packages/ && npm run --workspaces --if-present lint",
    "lint:fix": "eslint apps/shell/src/ apps/editor-remote/src/ apps/analytics-remote/src/ packages/ --fix",
    "test": "npm run test -w @velobits/shell",
    "test:watch": "npm run test:watch -w @velobits/shell",
    "test:coverage": "npm run test:coverage -w @velobits/shell",
    "test:packages": "npm run --workspaces --if-present test",
    "test:e2e": "npm run test:e2e -w @velobits/shell",
    "test:e2e:install": "playwright install --with-deps chromium",
    "gen:types": "openapi-typescript ../backend/openapi.json -o packages/api-client/src/types/openapi.d.ts",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "prepare": "husky",
    "deploy:shell": "npm run build:shell && npx wrangler pages deploy apps/shell/dist --project-name fixmytext-shell",
    "deploy:editor": "npm run build:editor && find apps/editor-remote/dist -name '*.map' -delete && npx wrangler pages deploy apps/editor-remote/dist --project-name fixmytext-editor-remote",
    "deploy:analytics": "npm run build:analytics && find apps/analytics-remote/dist -name '*.map' -delete && npx wrangler pages deploy apps/analytics-remote/dist --project-name fixmytext-analytics-remote",
    "deploy:content": "npm run build:cf -w @velobits/content-app && cd apps/content && npx wrangler deploy",
    "deploy:worker": "npm run deploy -w @velobits/cf-router-worker"
  }
}
