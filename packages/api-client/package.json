{
  "name": "@velobits/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gen:types": "openapi-typescript ../../../FixMyText-backend/openapi.json -o src/types/openapi.d.ts && prettier --write src/types/openapi.d.ts"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "*",
    "openapi-typescript": "*"
  }
}
